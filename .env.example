# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: 32+ byte secret used to sign HttpOnly session cookies.
SESSION_SECRET=""

# SANCTUARY_PASSWORD_SALT & SANCTUARY_PASSWORD_HASH:
# Pre-computed scrypt salt and 64-byte derived key for server-side constant-time verification.
SANCTUARY_PASSWORD_SALT="87a71dd8f69422a7537845252b186e34"
SANCTUARY_PASSWORD_HASH="00a3ae23364edd257e5aa17b962e5c44c008916b207243f25c93ce9fb80c84a07b6240ff388dd5383c6f8a942be292da2a3d0945c2acf72210e887153871a63b"
